{
  "name": "moni",
  "version": "1.5.0",
  "private": true,
  "license": "MIT",
  "description": "Moni: finanzas personales sobre Google Sheets con Apps Script",
  "scripts": {
    "test": "node tests/run.js",
    "sintaxis": "node tests/sintaxis.js",
    "login": "npx --yes @google/clasp login",
    "push": "npx --yes @google/clasp push",
    "pull": "npx --yes @google/clasp pull",
    "abrir": "npx --yes @google/clasp open-script",
    "contraste": "node tests/contraste.js",
    "verificar": "node tests/sintaxis.js && node tests/run.js && node tests/contraste.js",
    "vista": "node tests/dev_server.js",
    "push:dev": "bash scripts/publicar.sh desarrollo",
    "push:prod": "bash scripts/publicar.sh produccion",
    "vista:multi": "node tests/dev_server.js --multi",
    "deployments:dev": "npx --yes @google/clasp@3.4.1 -P \"$PWD/.clasp.dev.json\" list-deployments",
    "deployments:prod": "npx --yes @google/clasp@3.4.1 -P \"$PWD/.clasp.prod.json\" list-deployments",
    "paquete:prod": "bash scripts/publicar.sh produccion --armar",
    "desplegar:dev": "bash scripts/publicar.sh desarrollo --desplegar",
    "desplegar:prod": "bash scripts/publicar.sh produccion --desplegar",
    "hooks": "git config core.hooksPath .githooks"
  }
}
